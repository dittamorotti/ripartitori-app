{
  "name": "ripartitori-app",
  "version": "3.0.0",
  "description": "Gestione ripartitori e contabilizzatori QUNDIS",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "test": "node --test test/parser.test.mjs",
    "test:aggiorna": "node test/aggiorna-attesi.mjs",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jsdom": "^24.1.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "cross-env": "^10.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.1.0",
    "fuse.js": "^7.4.1",
    "image-size": "^2.0.2",
    "lucide-react": "^0.300.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "sql.js": "^1.14.1"
  },
  "build": {
    "appId": "com.qundis.ripartitori",
    "productName": "RipartitoriApp",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dittamorotti",
        "repo": "ripartitori-app",
        "releaseType": "release"
      }
    ],
    "files": [
      "package.json",
      "src/**/*",
      "dist-renderer/**/*",
      "node_modules/sql.js/dist/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist",
        "to": "sql.js/dist",
        "filter": [
          "*.wasm",
          "*.js"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "it"
      ],
      "language": "1040",
      "differentialPackage": false
    },
    "artifactName": "RipartitoriApp-Setup-${version}.${ext}",
    "electronUpdaterCompatibility": ">=2.16"
  }
}
